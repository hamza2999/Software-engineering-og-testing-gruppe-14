DATABASE_URL=file:./payload.db
PAYLOAD_SECRET=YOUR_SECRET_HERE
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173
# Sett false for en migreringsstyrt database uten automatisk skjemapush.
PAYLOAD_DB_PUSH=true

# E-post i utvikling. Bruk smtp og en testpostkasse for å prøve e-postflyten.
EMAIL_TRANSPORT=console
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025
# SMTP_FROM_ADDRESS=noreply@example.test
# SMTP_USER og SMTP_PASS settes kun dersom testpostkassen krever innlogging.
